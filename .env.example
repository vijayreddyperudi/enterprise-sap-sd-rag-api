# Groq API Key (Required for LLM inference)
GROQ_API_KEY=your_groq_api_key_here

# Groq LLM Model Name (Optional, defaults to llama-3.3-70b-versatile)
# Supported options: llama-3.3-70b-versatile, llama-3.1-8b-instant, deepseek-r1-distill-llama-70b
GROQ_MODEL=llama-3.3-70b-versatile

# RAG & Embedding Settings (Optional)
INDEX_PATH=data/faiss_index
PDF_PATH=data/Sample.pdf
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
